<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_registrierkasse.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="after">
         <t t-if="props.data.pos_kasse_code">
                <img t-att-src="props.data.pos_kasse_code" class="pos-receipt-qrcode"/>
                <div class="pos-receipt-order-data">
                    Kassenidentifikationsnummer: <t t-esc="props.data.kassenidentifikationsnummer" />
                </div>
                <div class="pos-receipt-order-data">
                    Fortlaufende Belegnummer:<t t-esc="props.data.fortlaufendeBelegnummer" />
                </div>
            </t>
        </xpath>
    </t>
</templates>
